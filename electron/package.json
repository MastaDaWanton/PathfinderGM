{
  "name": "pathfindergm-desktop",
  "version": "0.1.4",
  "private": true,
  "description": "Play a Pathfinder campaign inside a world generated by World Bible, entirely on your own machine.",
  "main": "main.js",
  "productName": "Pathfinder GM",
  "scripts": {
    "electron": "electron .",
    "build:backend": "cd .. && python -m PyInstaller --noconfirm pathfindergm.spec",
    "dist": "npm run build:backend && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pathfindergm.desktop",
    "productName": "Pathfinder GM",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/PathfinderGM.exe",
        "to": "backend/PathfinderGM.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pathfinder GM"
    }
  }
}

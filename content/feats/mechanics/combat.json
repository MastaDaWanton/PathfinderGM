  "two-weapon-defense": {
    "tags": ["two_weapon.defense"],
    "modifiers": [
      {
        "type": "combat_mod",
        "target": "ac",
        "amount": 1,
        "bonus_type": "shield",
        "when": {"bearer": {"state": "buff.stance.two-weapon-guard"}},
        "note": "while wielding two weapons: the round of a two-weapon full attack"

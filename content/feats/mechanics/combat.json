      {
        "type": "combat_mod",
        "target": "attack",
        "amount": -2,
        "bonus_type": "untyped",
        "when": {"choice": "rapid_shot", "weapon": {"ranged": true}}
      },
      {
        "type": "combat_mod",
        "target": "extra_attacks",
        "amount": 1,
        "bonus_type": "untyped",
        "when": {"choice": "rapid_shot", "full_attack": true, "weapon": {"ranged": true}},
        "note": "one more shot at the highest bonus, on a full attack"
      }
    ]
  },
  "manyshot": {
    "tags": ["attack.manyshot"]
  },

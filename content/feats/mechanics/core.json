  "power-attack": {
    "choice": "power_attack",
    "modifiers": [
      {
        "type": "combat_mod",
        "target": "attack",
        "formula": "-(1 + bab // 4)",
        "bonus_type": "untyped",
        "when": {
          "choice": "power_attack",
          "weapon": {
            "category": "melee"
          }
        }
      },
      {
        "type": "combat_mod",
        "target": "cmb",
        "formula": "-(1 + bab // 4)",
        "bonus_type": "untyped",
        "when": {
          "choice": "power_attack"
        }
      },
      {
        "type": "combat_mod",
        "target": "damage",
        "formula": "2 * (1 + bab // 4)",
        "bonus_type": "untyped",
        "when": {
          "choice": "power_attack",
          "weapon": {
            "category": "melee",
            "light": false
          }
        }
      },
      {
        "type": "combat_mod",
        "target": "damage",
        "formula": "(1 + bab // 4)",
        "bonus_type": "untyped",
        "when": {
          "choice": "power_attack",
          "weapon": {
            "category": "melee",
            "light": true
          }
        }
      },
      {
        "type": "combat_mod",
        "target": "damage",
        "formula": "(1 + bab // 4)",
        "bonus_type": "untyped",
        "when": {
          "choice": "power_attack",
          "weapon": {
            "category": "melee",
            "hands": 2
          }
        }
      }
    ],
    "not_yet": [
      "off-hand weapons take the light rung; the sheet has no off-hand yet",
      "touch attacks and effects that deal no hit-point damage are not excluded"
    ]
  },

  "reach-defense": {
    "modifiers": [
      {
        "type": "combat_mod",
        "target": "ac",
        "amount": 2,
        "bonus_type": "dodge",
        "when": {
          "opportunity": true,
          "adjacent": false
        },
        "note": "against attacks of opportunity from opponents not adjacent to you"
      }
    ]
  },
  "death-frombelow": {
    "modifiers": [
      {
        "type": "combat_mod",
        "target": "attack",
        "amount": 2,
        "bonus_type": "circumstance",
        "when": {
          "opportunity": true,
          "target": {
            "aloft": true
          }
        },
        "note": "an attack of opportunity against a flying opponent"
      }
    ],
    "not_yet": [
      "'when you have set a weapon against a charge': no readied action sets a weapon against a charge yet (the charge lane's machinery)"
    ]

  "greater-snap-shot": {
    "modifiers": [
      {
        "type": "combat_mod",
        "target": "damage",
        "formula": "2 + 2 * min(1, bab // 16) + 2 * min(1, bab // 20)",
        "bonus_type": "untyped",
        "when": {
          "opportunity": true,
          "weapon": {
            "ranged": true
          }

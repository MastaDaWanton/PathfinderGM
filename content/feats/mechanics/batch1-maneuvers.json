{
  "_about": [
    "Feat loop, batch 1, manoeuvres lane (2026-11-22): the combat manoeuvre feats and their",
    "relatives left without a document after round 3. Each benefit is the book's (aonprd.com",
    "FeatDisplay, the source named in feats.json), every number through the funnel. The CMB",
    "and CMD of a manoeuvre now carry its opponent (`target_actor` / `attacker_actor`) and the",
    "moment, so a term may ask of the foe (`target.state`) and of the board (`ally_beside`,",
    "`sole_threat`, sheet.Situation). What still does not run is the document's `not_yet`.",
    "Loaded beside core.json by rules/feats.py; nothing here is in another lane's file."
  ],
  "defensive-combat-training": {
    "modifiers": [
      {"type": "combat_mod", "target": "cmd", "formula": "max(0, hit_dice - bab)",
       "bonus_type": "untyped",
       "note": "total Hit Dice in place of base attack bonus in CMD"}
    ]
  },
  "fury-s-fall": {
    "modifiers": [
      {"type": "combat_mod", "target": "cmb", "formula": "max(0, dex_mod)",
       "bonus_type": "untyped", "scope": {"maneuver": "trip"},
       "note": "Dexterity bonus added to CMB on a trip"}
    ]
  },
  "kobold-style": {
    "modifiers": [
      {"type": "combat_mod", "target": "cmb", "amount": 4, "bonus_type": "untyped",
       "when": {"target": {"state": "state.exposed"}},
       "note": "against an enemy denied its Dexterity bonus to AC"}
    ]
  },
  "solo-maneuvers": {
    "modifiers": [

  "quivering-palm-adept": {
    "not_yet": [
      "'Add +2 to the saving throw DC against your quivering palm attacks': the monk's 15th-level quivering palm is a name on the class table with no ability document, so there is no DC to raise"
    ]
  },
  "amplified-rage": {
    "not_yet": [
      "'Whenever you are raging and adjacent to a raging ally who also has this feat or flanking the same opponent as a raging ally with this feat, your morale bonuses to Strength and Constitution increase by +4': a rage's morale terms are laid when it begins and ability scores are read with no board in their context, so nothing re-reads where a raging ally stands"
    ]
  },
  "improved-charging-hurler": {
    "not_yet": [
      "'When you use Charging Hurler, your target can be at any range ... If your target is within 30 feet, you gain a +2 bonus on damage rolls': Charging Hurler itself is lane b4-moves' (feat loop batch 4), and this lane has nothing of it to widen"
    ]
  },
  "sling-flail": {
    "not_yet": [
      "'You can make melee attacks using your loaded sling ... treating it as a flail', the flail feats with it, and 'magical or masterwork ammunition loses its special properties after a single hit': a sling is a ranged weapon in every reader, and no option swings it"
    ]
  },
  "quarterstaff-master": {
    "not_yet": [
      "'you can wield a quarterstaff as a one-handed weapon ... your other hand is free, and you cannot use the staff as a double weapon': the staff's two hands are the weapon row's, and no turn-start choice changes them",
      "'You can take the feat Weapon Specialization in the quarterstaff even if you have no levels in fighter': a prerequisite is asked of the feat, never of the weapon it is taken in"
    ]
  },
